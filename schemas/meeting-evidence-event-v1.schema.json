{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chau-hm/meeting-recorder/schemas/meeting-evidence-event-v1.schema.json",
  "title": "Meeting Evidence Bundle v1 event",
  "type": "object",
  "required": ["event_id", "type", "timestamp_ms"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "type": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "timestamp_ms": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
  },
  "if": {"properties": {"type": {"const": "screenshot"}}},
  "then": {
    "required": ["asset"],
    "properties": {
      "asset": {
        "type": "string", "minLength": 1,
        "pattern": "^(?!/)(?!.*[\\\\:*?\"<>|\\u0000-\\u001f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9¹²³]|[Ll][Pp][Tt][1-9¹²³])(?:\\.|/|$))(?!.*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
      }
    }
  }
}
